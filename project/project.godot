; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DigSlop"
run/main_scene="uid://d3yg8jlxa54m1"
config/features=PackedStringArray("4.5")
config/icon="res://icon.png"

[autoload]

DDD="*res://addons/zylann.debug_draw/debug_draw.gd"
Global="*res://smooth_terrain/Global.tscn"
Multiplayer="*res://smooth_terrain/multiplayer.tscn"
Debug="*res://smooth_terrain/debug.tscn"
UPNPHelper="*res://smooth_terrain/upnp.gd"
AppConfig="*res://addons/maaacks_options_menus/base/scenes/autoloads/app_config.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=0
window/stretch/mode="viewport"
window/dpi/allow_hidpi=false
window/quality/screen_space_aa=0
window/quality/msaa_3d=0

[editor_plugins]

enabled=PackedStringArray("res://addons/PathMesh3D/plugin.cfg", "res://addons/maaacks_options_menus/plugin.cfg")

[filesystem]

import/blender/enabled=false

